# Copy to .env (never commit .env). Validated at startup by src/platform/config.js.
NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://helpalarm:helpalarm@localhost:5432/helpalarm
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me
CORS_ORIGIN=http://localhost:5173
PUBLIC_WEB_URL=http://localhost:5173
# SMS: 'fake' logs messages to the console. 'twilio' needs the three values below.
SMS_PROVIDER=fake
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Web Push (generate NEW keys: npx web-push generate-vapid-keys). The old ones were leaked.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com